{
  "enabled": true,
  "name": "自动Git提交",
  "description": "监听项目文件变化，在任务完成后自动执行git add和commit操作",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.java",
      "**/*.ts",
      "**/*.vue",
      "**/*.yml",
      "**/*.xml",
      "**/*.md",
      "**/*.sql",
      "**/*.js",
      "**/*.css",
      "**/*.scss",
      "**/*.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "检测到文件变化，请执行以下git操作：1. 检查当前git状态 2. 添加所有变更的文件到暂存区 3. 创建一个有意义的中文提交信息 4. 执行git commit。请确保提交信息简洁明了，描述本次变更的主要内容。"
  }
}