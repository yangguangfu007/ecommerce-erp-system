{
  "enabled": true,
  "name": "Test Review Commit",
  "description": "Automatically executes unit tests and code review, then commits and pushes changes after task completion or feature modifications",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "*/src/main/java/**/*.java",
      "*/src/test/java/**/*.java",
      "pom.xml",
      "*/pom.xml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A Java file or Maven configuration has been modified. Please:\n1. Run the corresponding unit tests for the modified functionality\n2. Perform a code review of the changes\n3. If the test passes (mvn build no error and unit tests is successful, code coverage is over 90%) and the code review is satisfactory and manual confirmation is sought, please submit the changes in Chinese with appropriate submission information, otherwise fix the code until the test passes. Please try to mock data for testing.\n4. Push the changes to the repository\n\nFocus on the modified files and their related test files. Ensure code quality and test coverage before committing."
  }
}