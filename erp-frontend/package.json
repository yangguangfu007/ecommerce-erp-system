{
  "name": "erp-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:prod": "VITE_ENABLE_DEVTOOLS=false vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ci": "vitest --run --no-watch",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:api": "playwright test tests/api --reporter=list",
    "test:e2e": "playwright test",
    "test:performance": "vitest src/__tests__/performance.test.ts --run",
    "test:browser": "vitest src/__tests__/browser-compatibility.test.ts --run",
    "test:visual": "vitest src/__tests__/visual-regression.test.ts --run",
    "test:comprehensive": "tsx src/__tests__/comprehensive-test-runner.ts",
    "test:all": "npm run test:unit -- --run && npm run test:integration -- --run && npm run test:api && npm run test:e2e && npm run test:performance && npm run test:browser && npm run test:visual",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.10.4",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "happy-dom": "^18.0.1",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.5.3",
    "sass-embedded": "^1.89.2",
    "tsx": "^4.20.4",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
